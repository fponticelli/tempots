{
  "name": "@tempos/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm docs:prep && tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "eslint src --fix",
    "test:browser": "playwright test",
    "test:ssg": "vitest run test/static-pages.spec.ts",
    "docs:prep": "tsx ./scripts/prep-doc-contents.ts"
  },
  "dependencies": {
    "@tabler/icons": "^3.52.0",
    "@tempots/client": "workspace:*",
    "@tempots/dom": "workspace:*",
    "@tempots/server": "workspace:*",
    "@tempots/std": "workspace:*",
    "@tempots/ui": "workspace:*",
    "@tempots/vite": "workspace:*",
    "happy-dom": "21.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tempots/eslint-plugin": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.4.1",
    "highlight.js": "^11.12.0",
    "marked": "18.2.1",
    "marked-highlight": "^2.2.4",
    "monaco-editor": "0.57.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
