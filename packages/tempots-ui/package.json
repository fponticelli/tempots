{
  "name": "@tempots/ui",
  "private": false,
  "version": "5.1.0",
  "type": "module",
  "priority": 8,
  "description": "Provides a higher level of renderables to help fast development with Tempo.",
  "files": [
    "dist"
  ],
  "keywords": [
    "tempo",
    "tempots",
    "ui",
    "framework",
    "typescript",
    "dom",
    "components",
    "renderables"
  ],
  "homepage": "https://github.com/fponticelli/tempots",
  "bugs": {
    "url": "https://github.com/fponticelli/tempots/issues"
  },
  "author": {
    "name": "Franco Ponticelli",
    "email": "franco.ponticelli@gmail.com",
    "url": "https://github.com/fponticelli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fponticelli/tempots.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build && cp package.lib.json dist/package.json",
    "build:watch": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "docs": "npx api-extractor run --local && npx api-documenter markdown -i ./docs/input -o docs/output",
    "package:patch": "node -e 'require(\"./scripts/make.cjs\").update(\"patch\")'",
    "package:minor": "node -e 'require(\"./scripts/make.cjs\").update(\"minor\")'",
    "package:major": "node -e 'require(\"./scripts/make.cjs\").update(\"major\")'",
    "package:next": "node -e 'require(\"./scripts/make.cjs\").update(\"next\")'",
    "npm:prep": "pnpm build && cp README.md dist",
    "npm:prep:patch": "pnpm package:patch && pnpm npm:prep",
    "npm:prep:minor": "pnpm package:minor && pnpm npm:prep",
    "npm:prep:major": "pnpm package:major && pnpm npm:prep",
    "npm:prep:next": "pnpm package:next && pnpm npm:prep",
    "npm:publish:impl": "node -e 'require(\"./scripts/make.cjs\").publish()'",
    "npm:publish": "pnpm npm:prep && pnpm package:patch && pnpm npm:publish:impl",
    "npm:publish:minor": "pnpm npm:prep && pnpm package:minor && pnpm npm:publish:impl",
    "npm:publish:major": "pnpm npm:prep && pnpm package:major && pnpm npm:publish:impl",
    "npm:publish:next": "pnpm npm:prep && pnpm package:next && pnpm npm:publish:impl"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.1",
    "@tempots/dom": "workspace:*",
    "@tempots/std": "workspace:*"
  },
  "peerDependencies": {
    "@tempots/std": "0.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@microsoft/api-documenter": "^7.25.6",
    "@microsoft/api-extractor": "^7.47.1",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "happy-dom": "18.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.3"
  }
}
