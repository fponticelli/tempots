{
  "name": "tempo",
  "version": "1.0.0",
  "repository": "https://github.com/fponticelli/tempots.git",
  "author": "Franco Ponticelli <franco.ponticelli@gmail.com>",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "turbo build --filter='!js-framework-benchmark*'",
    "build:demos": "turbo build --filter=./demo/*",
    "build:watch": "turbo build:watch",
    "docs": "turbo run docs && pnpm --filter @tempos/docs docs:prep",
    "lint": "turbo lint --filter='!js-framework-benchmark*'",
    "format": "turbo format --filter='!js-framework-benchmark*'",
    "typecheck": "turbo typecheck --filter='!js-framework-benchmark*'",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage",
    "test": "turbo test --filter='!js-framework-benchmark*'",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage --filter='!js-framework-benchmark*'",
    "npm:publish": "turbo npm:publish",
    "publish": "node scripts/publish-all.js"
  },
  "devDependencies": {
    "inquirer": "^13.2.5",
    "turbo": "2.8.9"
  },
  "packageManager": "pnpm@9.15.9"
}
